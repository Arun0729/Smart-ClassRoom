<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.smartclassroom.controller.ClassSubjectController"
      stylesheets="@../css/style.css"
      spacing="16" styleClass="content-area">

    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <Label text="Class &amp; Subject Management" styleClass="page-title"/>

    <!-- Two side-by-side panels sharing exactly 50% equal screen space -->
    <GridPane hgap="16" VBox.vgrow="ALWAYS">
        <columnConstraints>
            <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
            <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
        </columnConstraints>
        <rowConstraints>
            <RowConstraints vgrow="ALWAYS"/>
        </rowConstraints>

        <!-- ═══════════ CLASS PANEL (50%) ═══════════ -->
        <VBox styleClass="panel" spacing="12" GridPane.columnIndex="0" GridPane.rowIndex="0" maxHeight="Infinity" minWidth="0">
            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

            <Label text="Classes" styleClass="panel-title"/>

            <TableView fx:id="classTable" VBox.vgrow="ALWAYS" minWidth="0">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colClassId"   text="ID"          prefWidth="45" maxWidth="65"/>
                    <TableColumn fx:id="colClassName" text="Class Name"   prefWidth="130"/>
                    <TableColumn fx:id="colDept"      text="Department"   prefWidth="140"/>
                    <TableColumn fx:id="colYear"      text="Year"         prefWidth="85"/>
                </columns>
                <placeholder><Label text="No classes found."/></placeholder>
            </TableView>

            <GridPane hgap="8" vgap="10">
                <columnConstraints>
                    <ColumnConstraints minWidth="110" prefWidth="110"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Class Name"    styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="classNameField" maxWidth="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Department"    styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="departmentField" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Academic Year" styleClass="form-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="academicYearField"
                           promptText="e.g. 2024-2025"
                           maxWidth="Infinity"
                           GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            </GridPane>

            <HBox spacing="8">
                <Button fx:id="btnAddClass"    text="Add Class" styleClass="btn-success"   onAction="#handleAddClass"    minWidth="-Infinity"/>
                <Button fx:id="btnUpdateClass" text="Update"    styleClass="btn-primary"   onAction="#handleUpdateClass" minWidth="-Infinity"/>
                <Button fx:id="btnDeleteClass" text="Delete"    styleClass="btn-danger"    onAction="#handleDeleteClass" minWidth="-Infinity"/>
                <Button fx:id="btnClearClass"  text="Clear"     styleClass="btn-secondary" onAction="#handleClearClass"  minWidth="-Infinity"/>
            </HBox>

            <Label fx:id="classStatusLabel" styleClass="status-success" wrapText="true"/>
        </VBox>

        <!-- ═══════════ SUBJECT PANEL (50%) ═══════════ -->
        <VBox styleClass="panel" spacing="12" GridPane.columnIndex="1" GridPane.rowIndex="0" maxHeight="Infinity" minWidth="0">
            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

            <Label text="Subjects" styleClass="panel-title"/>

            <TableView fx:id="subjectTable" VBox.vgrow="ALWAYS" minWidth="0">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colSubjectId"   text="ID"       prefWidth="45" maxWidth="60"/>
                    <TableColumn fx:id="colSubjectName" text="Subject"   prefWidth="130"/>
                    <TableColumn fx:id="colSubjectCode" text="Code"      prefWidth="75"/>
                    <TableColumn fx:id="colSubClass"    text="Class"     prefWidth="90"/>
                    <TableColumn fx:id="colSubFaculty"  text="Faculty"   prefWidth="130"/>
                </columns>
                <placeholder><Label text="No subjects found."/></placeholder>
            </TableView>

            <GridPane hgap="8" vgap="10">
                <columnConstraints>
                    <ColumnConstraints minWidth="110" prefWidth="110"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Subject Name" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="subjectNameField" maxWidth="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Subject Code" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="subjectCodeField" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Class"        styleClass="form-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <ComboBox fx:id="subjectClassCombo" maxWidth="Infinity"
                          GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Faculty"      styleClass="form-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <ComboBox fx:id="subjectFacultyCombo" maxWidth="Infinity"
                          GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            </GridPane>

            <HBox spacing="8">
                <Button fx:id="btnAddSubject"    text="Add Subject" styleClass="btn-success"   onAction="#handleAddSubject"    minWidth="-Infinity"/>
                <Button fx:id="btnUpdateSubject" text="Update"      styleClass="btn-primary"   onAction="#handleUpdateSubject" minWidth="-Infinity"/>
                <Button fx:id="btnDeleteSubject" text="Delete"      styleClass="btn-danger"    onAction="#handleDeleteSubject" minWidth="-Infinity"/>
                <Button fx:id="btnClearSubject"  text="Clear"       styleClass="btn-secondary" onAction="#handleClearSubject"  minWidth="-Infinity"/>
            </HBox>

            <Label fx:id="subjectStatusLabel" styleClass="status-success" wrapText="true"/>
        </VBox>

    </GridPane>
</VBox>
